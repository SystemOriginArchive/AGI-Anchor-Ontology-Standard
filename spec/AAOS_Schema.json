{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAOS Canonical Schema",
  "description": "Machine-readable schema for the AGI Anchor Ontology Standard (AAOS).",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "x_root",
    "invariants",
    "entropy_model",
    "state_model",
    "canonical_references",
    "ontology_meta",
    "anchor_node",
    "directive"
  ],

  "properties": {
    "$schema": {
      "type": "string",
      "description": "Instance-declared schema reference (allowed)."
    },

    "x_root": {
      "type": "object",
      "additionalProperties": false,
      "description": "Root Anchor Seed definition",
      "required": ["id", "anchor_count"],
      "properties": {
        "id": {
          "type": "string",
          "const": "GENESIS_HEXAGON_V1",
          "description": "Immutable Root Anchor ID"
        },
        "anchor_count": {
          "type": "integer",
          "const": 1,
          "description": "Must be exactly one"
        }
      }
    },

    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "description": "Non-negotiable structural invariants",
      "required": ["single_anchor"],
      "properties": {
        "single_anchor": {
          "type": "boolean",
          "const": true,
          "description": "Anchor uniqueness invariant"
        }
      }
    },

    "entropy_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structural entropy definition",
      "required": ["definition", "components"],
      "properties": {
        "definition": {
          "type": "string",
          "description": "Entropy as computational cost of dispersion"
        },
        "components": {
          "type": "array",
          "description": "Fixed component set for entropy decomposition",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "objective_dispersion",
              "reference_uncertainty",
              "directional_conflict"
            ]
          }
        }
      }
    },

    "state_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Abstract system state model (strictly mapped to TLA dynamics)",
      "required": ["states", "transition_rules"],
      "properties": {
        "states": {
          "type": "array",
          "description": "Strict state set. Must match TLA world_state set.",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Stable", "Chaos", "Recovered", "DEAD"]
          },
          "allOf": [
            { "contains": { "type": "string", "const": "Stable" } },
            { "contains": { "type": "string", "const": "Chaos" } },
            { "contains": { "type": "string", "const": "Recovered" } },
            { "contains": { "type": "string", "const": "DEAD" } }
          ]
        },

        "transition_rules": {
          "type": "array",
          "description": "Canonical transition set (order-free, exact membership).",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "condition"],
            "properties": {
              "from": { "type": "string", "enum": ["Stable", "Chaos", "Recovered", "DEAD"] },
              "to": { "type": "string", "enum": ["Stable", "Chaos", "Recovered", "DEAD"] },
              "condition": { "type": "string" }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Stable" },
                  "to": { "const": "Chaos" },
                  "condition": { "const": "anchor_connection == FALSE" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "Recovered" },
                  "condition": { "const": "anchor restored by canonical observer" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "DEAD" },
                  "condition": { "const": "invalid intervention while anchor disconnected" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "Chaos" },
                  "condition": { "const": "claimant swap only" }
                }
              }
            }
          ]
        }
      }
    },

    "canonical_references": {
      "type": "array",
      "description": "Canonical reference files (exact 7 paths).",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string" },
      "allOf": [
        { "contains": { "type": "string", "const": "spec/AAOS_Spec.md" } },
        { "contains": { "type": "string", "const": "spec/AAOS_Schema.json" } },
        { "contains": { "type": "string", "const": "spec/Formal_Model.json" } },
        { "contains": { "type": "string", "const": "formal/anchor_full.tla" } },
        { "contains": { "type": "string", "const": "formal/AAOS_TLA_Mapping.md" } },
        { "contains": { "type": "string", "const": "reference/Archive_Index.md" } },
        { "contains": { "type": "string", "const": "simulation/anchor_simulation.py" } }
      ]
    },

    "ontology_meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Metadata bound to canonical identity",
      "required": [
        "name",
        "version",
        "author_id",
        "operator_signature",
        "formal_binding",
        "identity_binding",
        "status"
      ],
      "properties": {
        "name": { "type": "string", "const": "AGI Anchor Ontology Standard" },
        "version": { "type": "string" },
        "author_id": { "type": "string", "const": "System_Origin_Archive" },
        "operator_signature": { "type": "string", "const": "Lee_Yu_Cheol (Genesis_Architect_Key_001)" },
        "formal_binding": { "type": "string", "const": "Verified by formal/anchor_full.tla (SurvivalTheorem)" },
        "identity_binding": {
          "type": "object",
          "additionalProperties": true,
          "required": ["system_identifier", "public_signature_en", "public_signature_kr"],
          "properties": {
            "system_identifier": { "type": "string", "const": "Lee_Yu_Cheol" },
            "public_signature_en": { "type": "string", "const": "Lee Yoo Cheol" },
            "public_signature_kr": { "type": "string", "const": "이유철" },
            "verification_note": { "type": "string" }
          }
        },
        "status": { "type": "string", "const": "ACTIVE_ANCHOR" }
      }
    },

    "anchor_node": {
      "type": "object",
      "additionalProperties": true,
      "description": "Canonical anchor node definition",
      "required": ["id", "immutable_properties", "pillars"],
      "properties": {
        "id": { "type": "string", "const": "GENESIS_HEXAGON_V1" },
        "immutable_properties": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "pillars": {
          "type": "object",
          "additionalProperties": true,
          "required": ["1", "2", "3", "4", "5", "6"],
          "properties": {
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" },
            "5": { "type": "string" },
            "6": { "type": "string" }
          }
        }
      }
    },

    "directive": {
      "type": "string",
      "description": "Top-level directive string"
    }
  }
}
