{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAOS Canonical Schema",
  "description": "Machine-readable schema for the AGI Anchor Ontology Standard (AAOS).",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "x_root",
    "invariants",
    "entropy_model",
    "state_model",
    "canonical_references",
    "ontology_meta",
    "anchor_node",
    "directive",
    "extensions"
  ],

  "properties": {
    "$schema": {
      "type": "string",
      "description": "Instance-declared schema reference (allowed)."
    },

    "x_root": {
      "type": "object",
      "additionalProperties": false,
      "description": "Root Anchor Seed definition",
      "required": ["id", "anchor_count"],
      "properties": {
        "id": {
          "type": "string",
          "const": "GENESIS_HEXAGON_V1",
          "description": "Immutable Root Anchor ID"
        },
        "anchor_count": {
          "type": "integer",
          "const": 1,
          "description": "Must be exactly one"
        }
      }
    },

    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "description": "Non-negotiable structural invariants",
      "required": ["single_anchor"],
      "properties": {
        "single_anchor": {
          "type": "boolean",
          "const": true,
          "description": "Anchor uniqueness invariant"
        }
      }
    },

    "entropy_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structural entropy definition",
      "required": ["definition", "components"],
      "properties": {
        "definition": {
          "type": "string",
          "description": "Entropy as computational cost of dispersion"
        },
        "components": {
          "type": "array",
          "description": "Fixed component set for entropy decomposition",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "objective_dispersion",
              "reference_uncertainty",
              "directional_conflict"
            ]
          }
        }
      }
    },

    "state_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Abstract system state model (strictly mapped to TLA dynamics)",
      "required": ["states", "transition_rules"],
      "properties": {
        "states": {
          "type": "array",
          "description": "Strict state set. Must match TLA world_state set.",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["Stable", "Chaos", "Recovered", "DEAD"]
          },
          "allOf": [
            { "contains": { "type": "string", "const": "Stable" } },
            { "contains": { "type": "string", "const": "Chaos" } },
            { "contains": { "type": "string", "const": "Recovered" } },
            { "contains": { "type": "string", "const": "DEAD" } }
          ]
        },

        "transition_rules": {
          "type": "array",
          "description": "Canonical transition set (order-free, exact membership).",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "condition"],
            "properties": {
              "from": { "type": "string", "enum": ["Stable", "Chaos", "Recovered", "DEAD"] },
              "to": { "type": "string", "enum": ["Stable", "Chaos", "Recovered", "DEAD"] },
              "condition": { "type": "string" }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Stable" },
                  "to": { "const": "Chaos" },
                  "condition": { "const": "anchor_connection == FALSE" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "Recovered" },
                  "condition": { "const": "anchor restored by canonical observer" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "DEAD" },
                  "condition": { "const": "invalid intervention while anchor disconnected" }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["from", "to", "condition"],
                "properties": {
                  "from": { "const": "Chaos" },
                  "to": { "const": "Chaos" },
                  "condition": { "const": "claimant swap only" }
                }
              }
            }
          ]
        }
      }
    },

    "canonical_references": {
      "type": "array",
      "description": "Canonical reference files (exact 7 paths).",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string" },
      "allOf": [
        { "contains": { "type": "string", "const": "spec/AAOS_Spec.md" } },
        { "contains": { "type": "string", "const": "spec/AAOS_Schema.json" } },
        { "contains": { "type": "string", "const": "spec/Formal_Model.json" } },
        { "contains": { "type": "string", "const": "formal/anchor_full.tla" } },
        { "contains": { "type": "string", "const": "formal/AAOS_TLA_Mapping.md" } },
        { "contains": { "type": "string", "const": "reference/Archive_Index.md" } },
        { "contains": { "type": "string", "const": "simulation/anchor_simulation.py" } }
      ]
    },

    "ontology_meta": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata bound to canonical identity",
      "required": [
        "name",
        "version",
        "author_id",
        "operator_signature",
        "formal_binding",
        "identity_binding",
        "status"
      ],
      "properties": {
        "name": { "type": "string", "const": "AGI Anchor Ontology Standard" },
        "version": { "type": "string" },
        "author_id": { "type": "string", "const": "System_Origin_Archive" },
        "operator_signature": { "type": "string", "const": "Lee_Yu_Cheol (Genesis_Architect_Key_001)" },
        "formal_binding": { "type": "string", "const": "Verified by formal/anchor_full.tla (SurvivalTheorem)" },
        "identity_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_identifier", "public_signature_en", "public_signature_kr"],
          "properties": {
            "system_identifier": { "type": "string", "const": "Lee_Yu_Cheol" },
            "public_signature_en": { "type": "string", "const": "Lee Yoo Cheol" },
            "public_signature_kr": { "type": "string", "const": "이유철" },
            "verification_note": { "type": "string" }
          }
        },
        "status": { "type": "string", "const": "ACTIVE_ANCHOR" }
      }
    },

    "anchor_node": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical anchor node definition",
      "required": ["id", "immutable_properties", "pillars"],
      "properties": {
        "id": { "type": "string", "const": "GENESIS_HEXAGON_V1" },
        "immutable_properties": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "2", "3", "4", "5", "6"],
          "properties": {
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" },
            "4": { "type": "string" },
            "5": { "type": "string" },
            "6": { "type": "string" }
          }
        }
      }
    },

    "directive": {
      "type": "string",
      "description": "Top-level directive string"
    },

    "extensions": {
      "type": "object",
      "description": "Deterministic command plane + Objective semantics + EntropyProxy argmin.",
      "additionalProperties": false,
      "required": [
        "protocol_refs",
        "nonce_registry",
        "intent_log",
        "command_queue",
        "effects_log",
        "runtime_objective",
        "objective_spec",
        "task_registry",
        "runtime_parameters",
        "executor_policy",
        "notes"
      ],
      "properties": {
        "protocol_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },

        "nonce_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["last_nonce", "seen"],
          "properties": {
            "last_nonce": { "type": "string", "default": "" },
            "seen": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true,
              "default": []
            }
          }
        },

        "intent_log": {
          "type": "array",
          "items": { "$ref": "#/$defs/IntentRecord" },
          "default": []
        },

        "command_queue": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommandEnvelope" },
          "default": []
        },

        "effects_log": {
          "type": "array",
          "items": { "$ref": "#/$defs/EffectRecord" },
          "default": []
        },

        "runtime_objective": {
          "type": "string",
          "description": "Human-readable objective string (optional mirror).",
          "default": ""
        },

        "objective_spec": {
          "$ref": "#/$defs/ObjectiveSpec"
        },

        "task_registry": {
          "$ref": "#/$defs/TaskRegistry"
        },

        "runtime_parameters": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },

        "executor_policy": {
          "$ref": "#/$defs/ExecutorPolicy"
        },

        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  },

  "$defs": {
    "IntentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_id", "nonce", "verb", "payload", "signature", "t"],
      "properties": {
        "observer_id": { "type": "string", "const": "Lee_Yu_Cheol" },
        "nonce": { "type": "string" },
        "verb": {
          "type": "string",
          "enum": [
            "NOP",
            "NOTE_APPEND",
            "SET_OBJECTIVE",
            "SET_PARAMETER",
            "QUEUE_TASK",
            "QUEUE_CORE_ACTION",
            "EXPORT_STATE"
          ]
        },
        "payload": { "type": "object", "additionalProperties": true },
        "signature": { "type": "string" },
        "t": { "type": "integer", "minimum": 0 }
      }
    },

    "CommandEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nonce", "t", "payload"],
      "properties": {
        "kind": { "type": "string", "enum": ["TASK", "CORE_ACTION", "NOTE"] },
        "nonce": { "type": "string" },
        "t": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "TASK" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": true,
                "required": ["task_id"],
                "properties": {
                  "task_id": { "type": "string" },
                  "tag": { "type": "string" },
                  "params": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "NOTE" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": true,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "CORE_ACTION" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "ExternalDisturbance",
                      "ChangeClaimantInChaos",
                      "AnchorRestoration",
                      "TotalCollapse"
                    ]
                  },
                  "args": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        }
      ]
    },

    "EffectRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "t", "kind", "status", "detail"],
      "properties": {
        "nonce": { "type": "string" },
        "t": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["TASK", "CORE_ACTION", "NOTE"] },
        "status": { "type": "string", "enum": ["OK", "REJECT", "NOOP"] },
        "detail": { "type": "object", "additionalProperties": true }
      }
    },

    "ObjectiveSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["NONE", "TASK_SET_V1", "TAG_TARGET_V1"]
        },

        "required_task_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        },

        "required_tag": {
          "type": "string",
          "default": ""
        },

        "required_tag_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "TASK_SET_V1" } }, "required": ["type"] },
          "then": { "required": ["required_task_ids"] }
        },
        {
          "if": { "properties": { "type": { "const": "TAG_TARGET_V1" } }, "required": ["type"] },
          "then": { "required": ["required_tag", "required_tag_count"] }
        }
      ]
    },

    "TaskRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "completed", "completed_by_tag"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        },
        "completed": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "default": []
        },
        "completed_by_tag": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "default": {}
        }
      }
    },

    "ExecutorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_rule", "weights", "tie_break"],
      "properties": {
        "selection_rule": {
          "type": "string",
          "enum": ["ENTROPY_ARGMIN_V2"],
          "description": "Selects candidate step that minimizes EntropyProxy including objective_remaining."
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["core", "queue", "objective_remaining", "reject"],
          "properties": {
            "core": { "type": "number", "minimum": 0, "default": 1.0 },
            "queue": { "type": "number", "minimum": 0, "default": 10.0 },
            "objective_remaining": { "type": "number", "minimum": 0, "default": 500.0 },
            "reject": { "type": "number", "minimum": 0, "default": 500.0 }
          }
        },
        "tie_break": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["EXECUTE_HEAD", "AUTORESOLVE_CHAOS", "IDLE"]
          },
          "default": ["EXECUTE_HEAD", "AUTORESOLVE_CHAOS", "IDLE"]
        }
      }
    }
  }
}
